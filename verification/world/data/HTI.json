  {"id":"constitute Article 263-2","source":"constitute","country":"HTI","instrument":"Haiti 1987 (rev. 2012)","kind":"constitution","article":"Article 263-2","part":"article","lang":"en","topics":["symbols"],"text":"All members of the police and armed forces shall take an oath of allegiance and respect for the Constitution and the flag at the time of their enlistment.","url":"https://www.constituteproject.org/service/html?cons_id=Haiti_2012&lang=en","fetched":"2026-11-12","sha256":"9a55742d5a39555e802b73d3d51699347cb376d0ec758f45004463479d29803f"},
