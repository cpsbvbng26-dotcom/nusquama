 "country": "TUN",
 "sources": {
  "constitute": {"instrument":"Tunisia 2022","kind":"constitution","lang":"en","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","topics":["honours","sovereignty","symbols","fraud","data","defamation","quotation"],"official":"Constitute Project（英訳）","via":"direct","final":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","status":200,"length":56058,"sha256_full":"408ac02f5d14e7b1bdc8e25b8e985f057a1e9386b7faf37f39459cc1127fb140","articles":120,"searched":["honours","sovereignty","symbols","fraud","data","defamation","quotation"],"constitute_id":"Tunisia_2022","title":"Tunisia 2022","year_enacted":"2022","year_updated":null,"page":"https://www.constituteproject.org/constitution/Tunisia_2022?lang=en"}
 },
 "provisions": [
  {"id":"constitute Article Eight:","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"Article Eight:","part":"article","lang":"en","topics":["symbols"],"text":"The flag of the Tunisian state is red, with a white circle in its center, bearing a five-pointed red star with surrounded by a red crescent, as determined by law.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"48e27edf1eaeb4aeb580ede683fbaefa3286d431d6cc62366bf1207276ba6dd2"},
  {"id":"constitute Article Eleven:","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"Article Eleven:","part":"article","lang":"en","topics":["symbols"],"text":"The official anthem of the Tunisian Republic is \"Homaat al-Hema\" [حماة الحمى = Protectors of the Sanctuary].","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"58df74c7d9fcd5d772efbec311a49a58aa0ae7e14c4794e9ba8742127609864c"},
  {"id":"constitute Article Ninety One:","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"Article Ninety One:","part":"article","lang":"en","topics":["sovereignty"],"text":"The President of the Republic is the guarantor of the independence of the country, the integrity of its territory, respect for the constitution and the law, and implementation of treaties. He ensures the normal functioning of public authorities and guarantees the continuity of the state. The President of the Republic chairs the National Security Council.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"ab3fdf17dd9e654ea36a00d69aa3490505a95fda5073aa3660088e8f28f345a7"},
  {"id":"constitute Article Sixty Six:","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"Article Sixty Six:","part":"article","lang":"en","topics":["defamation"],"text":"Members of Parliament shall not enjoy parliamentary immunity in relation to the felonies of slander, libel, and exchange of violence committed inside or outside the Assembly, nor shall they enjoy it in the event they disrupt the normal functioning of the Assembly.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"48e5b1048cefb951ad78d25be2e81b8f754916e750cb6d2c5d204e73c2592fc0"},
  {"id":"constitute Article Ten:","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"Article Ten:","part":"article","lang":"en","topics":["symbols"],"text":"The coat of arms of the Republic of Tunisia is determined by law.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"81affc125ff82e656ddcb30d8eb5d93c7af02951d6d57e5de3ef2ac99bd3a0c2"},
  {"id":"constitute Article Thirty:","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"Article Thirty:","part":"article","lang":"en","topics":["data"],"text":"The state protects privacy, the inviolability of the home, and the confidentiality of correspondence, communications, and personal data. Every citizen is free to choose his/her place of residence and to move within the country and has the right to leave it.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"bacf0af4707ab0a18c01810bb7c88d6e7b4285b5c7450143cb5afd6a3a69a213"},
  {"id":"constitute PREAMBLE ¶3","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"PREAMBLE","part":"paragraph 3","lang":"en","topics":["symbols"],"text":"We are the Tunisian people who offered legions of martyrs for emancipation and freedom, their pure blood mingling with this good land, painting it with the [two] colors of the national flag.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"6b166f8a3e2a6549a64e4e57aaa680519c5736d6575a6754ac2477d254fccdf9"},
  {"id":"constitute PREAMBLE ¶9","source":"constitute","country":"TUN","instrument":"Tunisia 2022","kind":"constitution","article":"PREAMBLE","part":"paragraph 9","lang":"en","topics":["symbols"],"text":"We approve this constitution inspired by the glories and pains of the past while looking forward to a better future for us and for generations that will come after us who will hoist the national flag higher and higher in every forum and under every sky.","url":"https://www.constituteproject.org/service/html?cons_id=Tunisia_2022&lang=en","fetched":"2026-11-12","sha256":"0bc5b1e126f691b7f0936010913827b3945d68acd2d7f72d45d0a3ba9cab04ba"}
 ]
}
