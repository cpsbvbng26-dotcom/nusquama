 "provisions": [
  {"id":"constitute Article 5","source":"constitute","country":"KWT","instrument":"Kuwait 1962 (reinst. 1992)","kind":"constitution","article":"Article 5","part":"article","lang":"en","topics":["honours","symbols"],"text":"The Law shall describe the Flag of the State, its Emblem, its Insignia, its Decorations and its National Anthem.","url":"https://www.constituteproject.org/service/html?cons_id=Kuwait_1992&lang=en","fetched":"2026-11-12","sha256":"4e83d72486066e15f47c4e024fabcb912a4e43e7fb100215646e0c7d8fda217a"},
  {"id":"constitute Article 76","source":"constitute","country":"KWT","instrument":"Kuwait 1962 (reinst. 1992)","kind":"constitution","article":"Article 76","part":"article","lang":"en","topics":["honours"],"text":"The Amir shall award orders of merit in accordance with the Law.","url":"https://www.constituteproject.org/service/html?cons_id=Kuwait_1992&lang=en","fetched":"2026-11-12","sha256":"2f84ae551f699b85bb608b62aca90131d8245b9301f5040758e005313b893e1a"},
  {"id":"constitute Article 122","source":"constitute","country":"KWT","instrument":"Kuwait 1962 (reinst. 1992)","kind":"constitution","article":"Article 122","part":"article","lang":"en","topics":["honours"],"text":"Excepting such members as fill public offices not incompatible with their membership, members of the National Assembly shall not be granted Orders of Merit during the period of their membership.","url":"https://www.constituteproject.org/service/html?cons_id=Kuwait_1992&lang=en","fetched":"2026-11-12","sha256":"0b02c4fd22827d8e2e9d6bd72b04e92198fd9856f469e4358126ceae2ed8a40b"}
