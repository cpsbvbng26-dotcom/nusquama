 "provisions": [
  {"id":"constitute ARTICLE IV. DECLARATION OF RIGHTS, Section 5","source":"constitute","country":"FSM","instrument":"Micronesia (Federated States of) 1978 (rev. 1990)","kind":"constitution","article":"ARTICLE IV. DECLARATION OF RIGHTS, Section 5","part":"article","lang":"en","topics":["data"],"text":"The right of the people to be secure in their persons, houses, papers, and other possessions against unreasonable search, seizure, or invasion of privacy may not be violated. A warrant may not issue except on probable cause, supported by affidavit particularly describing the place to be searched and the persons or things to be seized.","url":"https://www.constituteproject.org/service/html?cons_id=Micronesia_1990&lang=en","fetched":"2026-11-12","sha256":"a9e4b1895b0e39da11bf90407956eddab0d04d88ec1c176d9d5819fd21685192"},
  {"id":"constitute ARTICLE XI. JUDICIAL, Section 5","source":"constitute","country":"FSM","instrument":"Micronesia (Federated States of) 1978 (rev. 1990)","kind":"constitution","article":"ARTICLE XI. JUDICIAL, Section 5","part":"article","lang":"en","topics":["honours"],"text":"The qualifications and compensation of justices and other judges may be prescribed by statute. Compensation of judges may not be diminished during their terms of office unless all salaries prescribed by statute are reduced by a uniform percentage.","url":"https://www.constituteproject.org/service/html?cons_id=Micronesia_1990&lang=en","fetched":"2026-11-12","sha256":"c61211c3b35d1caf27bd5a9de1f3e8317f3dfac2e9ee3b3efe03ce9d35149f54"}
