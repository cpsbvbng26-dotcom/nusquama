 "provisions": [
  {"id":"IDN constitution Article 15","source":"constitute","country":"IDN","instrument":"Indonesia 1945 (reinst. 1959, rev. 2002)","kind":"constitution","article":"Article 15","part":"article","lang":"en","topics":["honours"],"text":"The President may grant titles, decorations and other honours as provided by law.","url":"https://www.constituteproject.org/service/html?cons_id=Indonesia_2002&lang=en","fetched":"2026-11-12","sha256":"de1be1655d072547358b45e5a28595c61a33ebe8528889675e6f506a8f1a19af"},
  {"id":"IDN constitution Article 35","source":"constitute","country":"IDN","instrument":"Indonesia 1945 (reinst. 1959, rev. 2002)","kind":"constitution","article":"Article 35","part":"article","lang":"en","topics":["symbols"],"text":"The national flag of Indonesia shall be the Red and White (Sang Merah Putih).","url":"https://www.constituteproject.org/service/html?cons_id=Indonesia_2002&lang=en","fetched":"2026-11-12","sha256":"25c1b18d689a7843103ca5f9d5679359472a9f93bf099c6211665d846bbf160b"},
  {"id":"IDN constitution Article 36A","source":"constitute","country":"IDN","instrument":"Indonesia 1945 (reinst. 1959, rev. 2002)","kind":"constitution","article":"Article 36A","part":"article","lang":"en","topics":["symbols"],"text":"The national coat of arms shall be the Pancasila eagle (Garuda Pancasila) with the motto Unity in Diversity (Bhinneka Tunggal Ika).","url":"https://www.constituteproject.org/service/html?cons_id=Indonesia_2002&lang=en","fetched":"2026-11-12","sha256":"50efd42e6f5f6d68380f4e4fb66146002d5712268331ac2ca1fbedd60625cf09"},
  {"id":"IDN constitution Article 36B","source":"constitute","country":"IDN","instrument":"Indonesia 1945 (reinst. 1959, rev. 2002)","kind":"constitution","article":"Article 36B","part":"article","lang":"en","topics":["symbols"],"text":"The national anthem shall be Indonesia Raya.","url":"https://www.constituteproject.org/service/html?cons_id=Indonesia_2002&lang=en","fetched":"2026-11-12","sha256":"0c2211f7a59bbed8280711e1d44b44fd0ab68ca2e6d5bf7c8b606e46fef820ab"},
  {"id":"IDN constitution Article 36C","source":"constitute","country":"IDN","instrument":"Indonesia 1945 (reinst. 1959, rev. 2002)","kind":"constitution","article":"Article 36C","part":"article","lang":"en","topics":["symbols"],"text":"Further provisions regarding the national flag, language, coat of arms and anthem shall be regulated by law.","url":"https://www.constituteproject.org/service/html?cons_id=Indonesia_2002&lang=en","fetched":"2026-11-12","sha256":"47b9aaca5d26617359929e2946bd73a6bbb104eede8db2bce548ccc1495ddcde"}
