  {"id":"constitute ARTICLE 1","source":"constitute","country":"DZA","instrument":"Algeria 2020","kind":"constitution","article":"ARTICLE 1","part":"article","lang":"en","topics":["sovereignty"],"text":"Algeria shall be a People’s Democratic Republic. It shall be one and indivisible.","url":"https://www.constituteproject.org/service/html?cons_id=Algeria_2020&lang=en","fetched":"2026-11-12","sha256":"cd44a77a2534307857049990931440d8d4dae02fd3a4b700a944638541971af2"},
